---
interface Props {
  title?: string;
  description?: string;
}

const { title = '张明轩 · 个人网站', description = '一个运维工程师的随笔、学习之旅与生活启发' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Dancing+Script:wght@500;700&family=Source+Code+Pro:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Noto Serif SC', serif;
      background: #f5f0e3;
      color: #3e2723;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
  </style>
</head>
<body>
  <nav>
    <div class="container">
      <div class="nav-links">
        <a href="/">首页</a>
        <a href="/ai-learning/">AI 学习记</a>
        <a href="/ops-notes/">运维记</a>
        <a href="/reading-life/">读书 &amp; 生活感悟</a>
        <a href="/projects/">作品集</a>
        <a href="/about/">About&nbsp; <span class="nav-mori">mori</span></a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    &copy; 2026&nbsp;&nbsp;&nbsp;&nbsp;<strong>MORI</strong> &middot; 用 <span class="heart-accent">&#x1f49c;</span> 和 AI 搭建
  </footer>

  <style is:global>
    /* 导航栏 */
    nav {
      display: flex; align-items: center;
      padding: 20px 0; border-bottom: 1px solid #e8d5c8;
      background: rgba(245,240,227,0.95); position: sticky; top: 0; z-index: 10;
    }
    .nav-links {
      display: flex; gap: 61.5px; font-size: 16px;
    }
    .nav-links a { color: #8b7355; transition: color 0.2s; white-space: nowrap; }
    .nav-links a:hover { color: #3e2723; }
    .nav-mori {
      font-family: 'Dancing Script', cursive;
      font-weight: 700; font-size: 24px;
    }

    /* 内容区 */
    .container { max-width: 960px; margin: 0 auto; padding: 0 24px; width: 100%; }

    /* Section 标题 */
    .section-title {
      font-size: 14px; text-transform: uppercase; letter-spacing: 2.5px;
      color: #b8956a; margin-bottom: 24px; font-weight: 600;
    }

    /* 主页各板块 */
    .section-block { padding: 60px 0 42px; }
    .section-block + .section-block { padding-top: 0; }

    /* 页脚 */
    footer {
      border-top: 1px solid #e8d5c8; padding: 24px 40px; text-align: center;
      font-size: 12px; color: #b8956a;
    }
    .heart-accent { color: #c44a7c; }

    /* 工具类 */
    .thought-link { text-decoration: none; color: inherit; }
    .thought-link:hover h2, .thought-link:hover h3 { color: #8b6914; }

    .btn-more { text-align: center; }
    .btn-more a {
      color: #8b6914; font-size: 14px; text-decoration: none; font-weight: 500;
      padding: 8px 24px; border: 1px solid #d4b896; border-radius: 4px;
      display: inline-block; transition: all 0.2s;
    }
    .btn-more a:hover { background: #faf3ea; border-color: #b8956a; }

    /* 列表页通用样式 */
    .list-header { padding: 60px 0 36px; }
    .list-category-tag {
      display: inline-block; padding: 6px 20px;
      background: #f5e6d3; color: #8b6914;
      font-size: 13px; font-weight: 600; border-radius: 4px;
    }
    .list-description { color: #b8956a; font-size: 14px; margin-top: 12px; }
    .list-items { padding-bottom: 60px; }
    .list-item {
      display: block; padding: 24px 0;
      border-bottom: 1px solid #e8d5c8;
      transition: background 0.15s;
    }
    .list-item:last-child { border-bottom: none; }
    .list-item:hover .list-item-title { color: #8b6914; }
    .list-item-title { font-size: 20px; font-weight: 600; line-height: 1.5; }
    .list-item-meta {
      display: flex; align-items: center; gap: 16px;
      font-size: 13px; color: #b8956a; margin-top: 8px;
    }
    .list-item-tags { display: flex; gap: 6px; }
    .list-item-tags span {
      padding: 2px 10px; background: #f5e6d3; color: #8b6914;
      border-radius: 3px; font-size: 11px;
    }
    .list-item-summary { color: #8b7355; font-size: 14px; line-height: 1.8; margin-top: 8px; }
  </style>
</body>
</html>
