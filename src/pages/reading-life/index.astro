---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('reading-life');
const sorted = entries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="读书 & 生活感悟 · 张明轩">
  <div class="container">
    <div class="list-header">
      <span class="list-category-tag">读书 &amp; 生活感悟</span>
      <p class="list-description">书页间的思考，生活中的启发</p>
    </div>

    <div class="list-items">
      {
        sorted.map(entry => (
          <a href={`/reading-life/${entry.slug}/`} class="list-item">
            <h3 class="list-item-title">{entry.data.title}</h3>
            <div class="list-item-meta">
              <span>{entry.data.date}</span>
              <div class="list-item-tags">
                {entry.data.tags.map(tag => <span>{tag}</span>)}
              </div>
            </div>
            <p class="list-item-summary">{entry.data.summary}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
